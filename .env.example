# WarrenTradingActivebot 환경 변수 설정
# 이 파일을 .env 로 복사 후 값을 입력하세요

# 실행 모드 (PAPER / LIVE)
TRADING_MODE=PAPER

# 초기 가상 자금 (Paper Trading)
PAPER_CAPITAL=10000000

# Alpaca API (미국 주식 실거래용 - Forward Testing 완료 후)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# 텔레그램 알림 (선택 — BotFather에서 발급)
# 1) @BotFather → /newbot → TOKEN 발급
# 2) @userinfobot 또는 웹훅으로 CHAT_ID 확인
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# TradingView 웹훅 보안키 (run_webhook.bat 실행 시 사용)
# TradingView Alert 메시지에 "secret": "여기값" 을 포함해야 수신됨
WEBHOOK_SECRET=warren2024
WEBHOOK_PORT=8080
